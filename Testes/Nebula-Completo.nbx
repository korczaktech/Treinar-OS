# Nebula — arquivo de conformidade sintatica
# Referencias normativas:
# korczaktech/Nebula/especificacao/gramatica.md
# korczaktech/Nebula/especificacao/tokens.md
# Este arquivo prioriza construcoes descritas pela gramatica atual.
# A aceitacao sintatica nao garante disponibilidade semantica ou no backend.

# 1. Declaracoes basicas e literais

constante NOME: texto = "Nebula"
constante LIMITE: inteiro = 100
constante PI: decimal = 3.14159
constante HABILITADO: logico = verdadeiro
constante DESABILITADO: logico = falso
constante INICIAL: caractere = 'N'
constante OCTETO: byte = 255

variavel contador: inteiro = 0
variavel mensagem: texto = "Teste"
variavel ativo: logico = sim
variavel ausente = nulo

# 2. Operadores aritmeticos, relacionais e logicos

variavel adicao: inteiro = 10 + 5
variavel subtracao: inteiro = 10 - 5
variavel produto: inteiro = 10 * 5
variavel quociente: decimal = 10 / 5
variavel divisaoInteira: inteiro = 10 // 3
variavel resto: inteiro = 10 % 3
variavel potencia: inteiro = 2 ** 3

variavel igual: logico = 10 == 10
variavel diferente: logico = 10 != 5
variavel menor: logico = 3 < 5
variavel menorOuIgual: logico = 3 <= 3
variavel maior: logico = 5 > 3
variavel maiorOuIgual: logico = 5 >= 5

variavel conjuncao: logico = verdadeiro e falso
variavel disjuncao: logico = verdadeiro ou falso
variavel negacao: logico = nao falso
variavel bitE: inteiro = 6 & 3
variavel bitOu: inteiro = 6 | 3
variavel bitXor: inteiro = 6 ^ 3
variavel deslocamentoEsquerda: inteiro = 1 << 2
variavel deslocamentoDireita: inteiro = 8 >> 1

# 3. Atribuicoes

funcao testarAtribuicoes() -> inteiro: {
    variavel valor: inteiro = 10
    alterar valor = 11
    alterar valor += 2
    alterar valor -= 1
    alterar valor *= 2
    alterar valor /= 2
    alterar valor //= 2
    alterar valor %= 3
    retorne valor
}

# 4. Listas, tuplas e acesso

variavel numeros: [inteiro] = [1, 2, 3, 4]
variavel vazia: [inteiro] = []
variavel par: (inteiro, texto) = (7, "sete")
variavel unitario: (inteiro,) = (9,)
variavel tuplaVazia: () = ()

variavel primeiro: inteiro = numeros[0]
variavel primeiroDoPar: inteiro = par[0]

# 5. Aliases e estruturas

tipo Identificador = inteiro

estrutura Ponto: {
    x: inteiro
    y: inteiro
}

variavel ponto: Ponto = Ponto { x: 10, y: 20 }
variavel coordenada: inteiro = ponto.x

# 6. Enumeracoes e escolha

enumeracao Estado: {
    Inativo
    Ativo
    Falha(texto)
}

funcao nomeEstado(estado: Estado) -> texto: {
    escolha estado: {
        caso Estado::Inativo: {
            retorne "inativo"
        }
        caso Estado::Ativo: {
            retorne "ativo"
        }
        caso Estado::Falha(mensagemErro): {
            retorne mensagemErro
        }
    }
}

# 7. Funcoes, parametros, retorno e genericos

funcao somar(a: inteiro, b: inteiro) -> inteiro: {
    retorne a + b
}

funcao semRetorno(valor: inteiro): {
    variavel copia: inteiro = valor
}

funcao comPadrao(valor: inteiro, incremento: inteiro = 1) -> inteiro: {
    retorne valor + incremento
}

funcao identidade<T>(valor: T) -> T: {
    retorne valor
}

variavel resultado: inteiro = somar(10, 20)
variavel resultadoPadrao: inteiro = comPadrao(5)
variavel resultadoGenerico: inteiro = identidade<inteiro>(42)
variavel resultadoNomeado: inteiro = somar(a = 3, b = 4)

# 8. Lambdas e tipos de funcao

variavel duplicar: funcao(inteiro): inteiro = valor -> valor * 2
variavel incrementar: funcao(inteiro): inteiro = lambda valor: valor + 1
variavel operacao: funcao(inteiro): inteiro = duplicar

# 9. Condicionais e clausulas encadeadas

funcao classificar(valor: inteiro) -> texto: {
    se valor > 10: {
        retorne "maior"
    }
    sendo valor == 10: {
        retorne "igual"
    }
    senao: {
        retorne "menor"
    }
}

# 10. Repeticoes e controle de fluxo

funcao somarIntervalo() -> inteiro: {
    variavel total: inteiro = 0
    para indice dentro 0..5: {
        alterar total += indice
    }
    retorne total
}

funcao repetirEnquanto() -> inteiro: {
    variavel indice: inteiro = 0
    enquanto indice < 3: {
        alterar indice += 1
    }
    retorne indice
}

funcao percorrerLista() -> inteiro: {
    variavel total: inteiro = 0
    cada item em numeros: {
        alterar total += item
    }
    retorne total
}

funcao repetirTradicional() -> inteiro: {
    variavel total: inteiro = 0
    para (variavel indice: inteiro = 0; indice < 3; indice++): {
        alterar total += indice
    }
    retorne total
}

funcao controlarLaco() -> inteiro: {
    variavel indice: inteiro = 0
    enquanto indice < 10: {
        alterar indice += 1
        se indice == 2: {
            prossiga
        }
        se indice == 5: {
            pare
        }
    }
    retorne indice
}

# 11. Tratamento de erros

funcao testarTratamento() -> vazio: {
    tente: {
        verifique verdadeiro, "condicao de teste"
    }
    erro falha: {
        passar
    }
    sempre: {
        passar
    }
}

# 12. Classes, construtor e modificadores

classe Contador: {
    variavel valor: inteiro = 0

    funcao construtor(): {
        alterar isto.valor = 0
    }

    publico funcao incrementar() -> inteiro: {
        alterar isto.valor += 1
        retorne isto.valor
    }

    privado funcao zerar(): {
        alterar isto.valor = 0
    }

    estatico funcao inicial() -> inteiro: {
        retorne 0
    }
}

# 13. Contextos de seguranca

seguro: {
    variavel operacaoSegura: inteiro = 1
}

critico: {
    variavel operacaoCritica: inteiro = 2
}

# 14. Sintaxe de encerramento
# Todos os Function Bodies sao delimitados por : { e }.
# "fim" nao e delimitador de bloco na sintaxe atual.
